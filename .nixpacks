{
  "phases": {
    "install": {
      "cmds": ["cd backend && composer install --optimize-autoloader --no-dev --no-interaction"]
    },
    "build": {
      "cmds": [
        "cd backend && php artisan config:clear",
        "cd backend && php artisan cache:clear"
      ]
    }
  },
  "start": {
    "cmd": "cd backend && php artisan migrate --force && php artisan serve --host=0.0.0.0 --port=$PORT"
  }
}
